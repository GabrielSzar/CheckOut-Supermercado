<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Image.produtoImg">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="120" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>
    
    <Style Selector="WrapPanel.gridProdutos">
        <Setter Property="ItemWidth" Value="120" />
        <Setter Property="ItemHeight" Value="120" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.cardProduto">
        <!--Queria colocar margin no StackPanel, Achei que era um StackPanel para cada produto,
            mas Aparentemente e tudo em um so StackPanel porque eu coloquei margem e ao inves de separar
            Cada Card, separou os Cards da borda da Janela-->
        <Setter Property="Margin" Value="0"/>
    </Style>
</Styles>